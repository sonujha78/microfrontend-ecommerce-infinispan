{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "5be0ad6c-87c1-46fe-911e-2b5d17b3f491"
  },
  "newProjectRoot": "projects",
  "projects": {
    "checkout-admin-angular": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "."
              }
            ],
            "styles": ["src/styles.css"],
            "main": "src/main.ts",
            "outputPath": "dist/checkout-admin-angular",
            "index": "src/index.html",
            "customWebpackConfig": {
              "path": "webpack.config.js"
            },
            "commonChunk": false,
            "extractLicenses": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "customWebpackConfig": {
                "path": "webpack.prod.config.js"
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "checkout-admin-angular:build:production"
            },
            "development": {
              "buildTarget": "checkout-admin-angular:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 3003,
            "publicHost": "http://localhost:3003",
            "headers": {
              "Access-Control-Allow-Origin": "*"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
